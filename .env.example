# Copy this file to `.env` in the repo root. docker-compose automatically
# loads it and substitutes these values into docker-compose.yml.

# --- Frontend build arg / runtime config ---
# Absolute URL the BROWSER uses to reach the backend. Since the browser
# runs on the host (not inside the Docker network), this must be a
# host-reachable address, e.g. http://localhost:8000.
VITE_BACKEND_URL=http://localhost:8000
FRONTEND_PORT=5173

# --- Backend ---
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- Redis ---
REDIS_PORT=6379
