# --- Backend service configuration ---
SERVICE_NAME=system-pulse-backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list, or "*" for any origin
CORS_ORIGINS=*

# --- Redis connection ---
# In docker-compose, "redis" resolves via the custom bridge network's DNS.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
