# Environment files (local secrets/config, never commit)
.env
backend/.env
frontend/.env

# Node
node_modules/
frontend/dist/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Terraform
# .terraform.lock.hcl IS committed on purpose (locks provider versions).
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/*.tfplan
infra/tfplan.out
infra/crash.log
infra/crash.*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
